{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "small_model": "deepseek/deepseek-v4-flash",
  "tools": {
    "websearch": false,
    "webfetch": false
  },
  "mcp": {
    "hound": {
      "type": "local",
      "command": ["hound"]
    }
  },
  "agent": {
    "review": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "to-spec": {
      "model": "deepseek/deepseek-v4-pro"
    },
    "to-tickets": {
      "model": "deepseek/deepseek-v4-pro"
    }
  }
}
